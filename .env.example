# Wayfare Mobile API Configuration
EXPO_PUBLIC_API_URL=https://travelsharingbackend-production.up.railway.app/api

# Google Gemini AI is securely proxied through Wayfare Backend (/api/ai/generate).
# Optional client fallback key (only if running offline/without backend AI proxy):
# EXPO_PUBLIC_GEMINI_API_KEY=optional_fallback_key_here

# Google OAuth 2.0 Client ID for Google Sign-In
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
