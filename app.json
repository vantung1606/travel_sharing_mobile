{
  "expo": {
    "name": "Wayfare Travel",
    "slug": "wayfare-travel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wayfare",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.wayfare.travelmobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F8F4EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1E1A15",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#1E1A15"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wayfare cần quyền truy cập thư viện ảnh để bạn tải ảnh bài viết và ảnh đại diện.",
          "cameraPermission": "Wayfare cần quyền truy cập máy ảnh để chụp ảnh địa điểm và khoảnh khắc du lịch."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Wayfare cần quyền truy cập vị trí để gợi ý các địa điểm du lịch gần bạn."
        }
      ],
      "expo-video",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
